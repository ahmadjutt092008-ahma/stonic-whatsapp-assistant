{
  "name": "Stonic v1 · Reminder Sender",
  "nodes": [
    {
      "id": "67cdd50e-b34d-4cf5-af86-2a72b57e22ec",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -240
      ],
      "parameters": {
        "width": 600,
        "height": 200,
        "content": "## Stonic Reminders\nHar 5 minute: jo reminder ka time aa gaya, WhatsApp pe bhejo aur 'sent' mark karo.\n\n**WhatsApp rule:** user ke aakhri message ke 24 ghante baad free-text message nahi jata, uske liye approved template chahiye. Stage 1 testing ke liye 24 ghante ke andar ke reminders theek kaam karenge."
      }
    },
    {
      "id": "8946768b-4114-4169-8f97-e10f37ef1fe2",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "b412579b-0f01-4aa0-b1c0-b45378abaaf8",
      "name": "Get Pending Reminders",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "PASTE_TABLE_ID_stonic_reminders",
          "cachedResultName": "stonic_reminders"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "9f336073-51aa-4403-b9db-defa20b59a83",
      "name": "Due Now",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "31e6b86e-19a6-421e-8c15-532492ff9e7d",
              "leftValue": "={{ DateTime.fromISO($json.due_at) <= $now }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "bb47dca1-8488-48b8-bd4d-e6cbb01b56a9",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "send",
        "phoneNumberId": "PASTE_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "textBody": "=⏰ Reminder: {{ $json.text }}",
        "additionalFields": {}
      }
    },
    {
      "id": "3ac2e38d-20ef-4e49-ac1c-474c558bd155",
      "name": "Mark as Sent",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "PASTE_TABLE_ID_stonic_reminders",
          "cachedResultName": "stonic_reminders"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Due Now').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "sent"
          },
          "schema": [
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Pending Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Reminders": {
      "main": [
        [
          {
